   "source": [
    "# Milestone 4: Portability & Fallbacks\n",
    "\n",
    "## Goal\n",
    "Abstract your LLM calls behind an adapter that automatically falls back to a secondary model if the primary model fails or violates a contract. This ensures your Support Copilot doesn't go down during a vendor outage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ModelRouter:\n",
    "    def __init__(self):\n",
    "        pass\n",
    "        \n",
    "    def generate_response(self, prompt: str, simulate_failure: bool = False):\n",
    "        if simulate_failure:\n",
    "            print(\"\ud83d\udea8 Primary model failed! Falling back to secondary...\")\n",
    "            return \"(Fallback Model Response) Hello, how can I help?\"\n",
    "        else:\n",
    "            print(\"\u2705 Primary model succeeded.\")\n",
    "            return \"(Primary Model Response) Hello, how can I help?\"\n",
    "\n",
    "router = ModelRouter()\n",
    "print(router.generate_response(\"Hi\"))\n",
    "print(router.generate_response(\"Hi\", simulate_failure=True))\n"
   ]
  }
 ],
